rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read and write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Allow authenticated users to read all users (for admin stats)
    match /users/{document=**} {
      allow read: if request.auth != null;
    }
    
    // Allow users to read/write their own referrals, commissions, notifications
    match /referrals/{referralId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.sponsorId;
    }
    
    match /commissions/{commissionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /payments/{paymentId} {
      allow read, write: if request.auth != null;
    }
    
    match /transactions/{transactionId} {
      allow read, write: if request.auth != null;
    }
    
    match /withdrawals/{withdrawalId} {
      allow read, write: if request.auth != null;
    }
    
    match /matrix/{matrixId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow reading packages and settings
    match /packages/{packageId} {
      allow read: if true;
    }
    
    match /settings/{settingId} {
      allow read: if true;
    }
    
    // Only allow admins to read and write pins
    match /pins/{pinId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    
    match /stockists/{stockistId} {
      allow read, write: if request.auth != null;
    }
    
    match /stockistTransactions/{transactionId} {
      allow read, write: if request.auth != null;
    }
    
    match /activity_logs/{logId} {
      allow read, write: if request.auth != null;
    }
    
    match /bonuses/{bonusId} {
      allow read, write: if request.auth != null;
    }
    
    match /support_tickets/{ticketId} {
      allow read, write: if request.auth != null;
    }
  }
}